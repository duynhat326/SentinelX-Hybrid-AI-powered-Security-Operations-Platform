# Copy to .env and fill in. Never commit .env.
# Generate values with: openssl rand -hex 24
SENTINELX_API_KEY=
POSTGRES_PASSWORD=
SENTINELX_BRUTEFORCE_THRESHOLD=5
SENTINELX_BRUTEFORCE_WINDOW_SECONDS=300
# AI investigation: none (off, default) or mock (offline canned model for demos and tests; no real LLM exists yet)
SENTINELX_LLM_PROVIDER=none
# Threat intelligence from VirusTotal / AbuseIPDB (optional). Off by default: a lookup tells the provider what you are investigating.
# Even when enabled, every request must also set confirm_external=true. The local IOC table works without any of this.
SENTINELX_TI_EXTERNAL_ENABLED=false
SENTINELX_VT_API_KEY=
SENTINELX_ABUSEIPDB_API_KEY=
# Response actions. false (default): approving an action only simulates it. true: approved blocklist entries and reports take real effect
# inside SentinelX (nothing here enforces a blocklist). PROTECTED_IPS: addresses/networks that no response may target, e.g. 10.0.0.1,192.168.0.0/16
SENTINELX_RESPONSE_REAL_ACTIONS_ENABLED=false
SENTINELX_PROTECTED_IPS=
